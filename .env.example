# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
CW_AUTOMATE_SERVER_URL=
CW_AUTOMATE_CLIENT_ID=
CW_AUTOMATE_USERNAME=
CW_AUTOMATE_PASSWORD=
# CW_AUTOMATE_2FA_CODE=
# CW_AUTOMATE_AUTH_METHOD=integrator

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors MCP_HTTP_HOST (the container image
# sets 0.0.0.0). With no secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
# Local development only: MCP_ALLOW_INSECURE_DEV=1 starts HTTP without this
# secret, logs a warning, skips X-Gateway-S2S, and binds 127.0.0.1 only.
CONDUIT_S2S_SECRET=
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-CWA-Server, X-CWA-Client-ID, X-CWA-Username, and X-CWA-Password headers;
# no env fallback). The container image and compose service set gateway.
# Stdio ignores this and reads CW_AUTOMATE_* from the environment.
# AUTH_MODE=env

# LOG_LEVEL=info
